# =============================================================================
# Frontend Environment Configuration Template
# =============================================================================

# Public backend API URL for cross-origin deployments (e.g. frontend on Vercel,
# backend deployed on Railway, Render, Fly.io, or behind an ngrok tunnel).
# Leave empty for standard same-origin deployments where the frontend is served
# directly by the backend or reverse-proxied under the same origin (default: "").
#
# Examples:
#   VITE_API_BASE_URL=
#   VITE_API_BASE_URL=https://my-backend.ngrok-free.app
#   VITE_API_BASE_URL=https://api.yourcompany.com
VITE_API_BASE_URL=
