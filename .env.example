# =============================================================================
# Enterprise RAG Assistant Configuration Template
# Generate a ready .env file by running: python scripts/setup.py
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core & Server Configuration
# -----------------------------------------------------------------------------
# Environment mode: 'development', 'production', or 'test'
APP_ENV=development
# Host interface to bind Uvicorn (0.0.0.0 for all interfaces, 127.0.0.1 for local only)
HOST=0.0.0.0
# Port to listen on (default: 8000)
PORT=8000
# Semantic version identifier of the deployment build
BUILD_VERSION=1.0.0
# Set to 'true' ONLY behind HTTPS. If true over HTTP, browsers reject cookies causing a login loop
COOKIE_SECURE=false
# Enable demo mode banner and demo credentials helper on login screen (forbidden in production)
DEMO_MODE=false
# Set to 'true' when operating behind a reverse proxy (e.g. Nginx, Caddy, IIS) to trust forwarded headers
BEHIND_PROXY=false
# Public base URL of the application when accessed externally (e.g. https://chat.example.com)
PUBLIC_URL=
# Comma-separated list of allowed CORS origins (empty by default for single-origin deployment)
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# 2. Company Branding & White-Labeling
# -----------------------------------------------------------------------------
# Default organization name displayed in interface header and document titles
COMPANY_NAME=Company Assistant

# -----------------------------------------------------------------------------
# 3. LLM Configuration (Groq is the only LLM provider)
# -----------------------------------------------------------------------------
# Groq API key (obtain from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Primary Groq model used for conversational RAG synthesis
GROQ_MODEL=qwen/qwen3.8-27b
# Fast Groq model used for quick tasks and query rewriting
GROQ_FAST_MODEL=openai/gpt-oss-20b
# Vision model used for image description and visual query answering
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Fallback / optional OpenAI API key (unused when Groq is configured)
OPENAI_API_KEY=
# LLM sampling temperature between 0.0 (strictly deterministic) and 1.0 (creative)
LLM_TEMPERATURE=0.2

# -----------------------------------------------------------------------------
# 4. Security & JWT Authentication
# -----------------------------------------------------------------------------
# Cryptographic secret for signing JWT tokens. Auto-generated by python scripts/setup.py
JWT_SECRET=your_jwt_secret_here_generate_with_setup_script
# HMAC signing algorithm for tokens
JWT_ALGORITHM=HS256
# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 5. Initial Administrator & Account Seeding
# -----------------------------------------------------------------------------
# Email address for the bootstrap administrator account (or use scripts/create_admin.py)
ADMIN_EMAIL=admin@example.com
# Password for bootstrap admin (minimum 10 characters, common weak defaults rejected)
ADMIN_PASSWORD=your_admin_password_here

# -----------------------------------------------------------------------------
# 6. Demo Accounts Seeding (Development only; refused when APP_ENV=production)
# -----------------------------------------------------------------------------
# Seed demo accounts on startup (must be false in production)
SEED_DEMO_USERS=false
# Demo admin email address
DEMO_ADMIN_EMAIL=demo_admin@example.com
# Demo admin password
DEMO_ADMIN_PASSWORD=your_demo_admin_password_here
# Demo standard user email address
DEMO_USER_EMAIL=demo_user@example.com
# Demo standard user password
DEMO_USER_PASSWORD=your_demo_user_password_here

# -----------------------------------------------------------------------------
# 7. Database & Storage Paths
# -----------------------------------------------------------------------------
# Base data directory for persisted files
DATA_DIR=data
# Storage root directory (defaults to repository root)
STORAGE_DIR=.
# SQLAlchemy database URL (SQLite default: sqlite:///./rag_company.db)
DATABASE_URL=sqlite:///./rag_company.db
# Directory for persistent ChromaDB vector collections
CHROMA_DIR=chroma_data
# Legacy alias for CHROMA_DIR
CHROMA_PERSIST_DIR=chroma_data
# Directory for uploaded documents, extracted images, and rendered pages
UPLOAD_DIR=uploads
# Directory for application request and error logs
LOG_DIR=logs
# Directory for cached offline AI models (HuggingFace / EasyOCR)
MODELS_DIR=

# -----------------------------------------------------------------------------
# 8. Embedding & Retrieval Settings
# -----------------------------------------------------------------------------
# Hugging Face model identifier for vector embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# Cosine similarity gate for company-scope queries (replies 'couldn't find' if below)
SIMILARITY_THRESHOLD=0.35
# Number of document chunks retrieved for RAG context
TOP_K_CHUNKS=5
# Enable hybrid retrieval combining BM25 keyword search with dense vector embeddings
USE_HYBRID=false
# Enable cross-encoder reranking over retrieved chunks
USE_RERANKER=false

# -----------------------------------------------------------------------------
# 9. Computer Vision & Image Matching
# -----------------------------------------------------------------------------
# Maximum perceptual hash Hamming distance for duplicate or near-duplicate detection
IMAGE_HASH_MAX_DISTANCE=12
# Minimum SIFT keypoint inliers required for RANSAC homography geometric match
SIFT_MIN_INLIERS=15
# Minimum confidence threshold for visual image matching
IMAGE_MATCH_MIN_CONFIDENCE=0.40
# Pre-initialize EasyOCR on application startup rather than lazy-loading
WARMUP_OCR=false

# -----------------------------------------------------------------------------
# 10. SMTP Email Configuration (Optional for Password Reset)
# -----------------------------------------------------------------------------
# SMTP mail server hostname (if unset, password resets route to Admin Approval inbox)
SMTP_HOST=
# SMTP mail server port (typically 587 for STARTTLS or 465 for SSL)
SMTP_PORT=587
# SMTP username / login email
SMTP_USER=
# SMTP account password
SMTP_PASSWORD=
# Outgoing sender email address (defaults to SMTP_USER if omitted)
SMTP_FROM=
# Enable STARTTLS encryption for SMTP connections
SMTP_TLS=true

# -----------------------------------------------------------------------------
# 11. Concurrency & Resource Controls (Optimized for 2-8 GB RAM servers)
# -----------------------------------------------------------------------------
# Maximum concurrent CPU/memory-heavy background tasks (OCR, PDF rendering, homography)
MAX_HEAVY_TASKS=2
# Maximum concurrent streaming chat sessions before queuing
MAX_CONCURRENT_CHATS=6
