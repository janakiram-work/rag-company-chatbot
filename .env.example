# Company Branding
COMPANY_NAME=ABC Technologies

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_TEMPERATURE=0.2

# Application Security & Database
JWT_SECRET=supersecretproductionragkey_abctechnologies_2026_changeinprod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL=admin@abctechnologies.com
ADMIN_PASSWORD=Admin@123
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001
# Default SQLite: sqlite:///./rag_company.db | PostgreSQL: postgresql://rag_user:rag_password@localhost:5432/rag_company
DATABASE_URL=sqlite:///./rag_company.db

# Vector Store & Storage
CHROMA_PERSIST_DIR=./chroma_data
UPLOAD_DIR=./uploads
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Retrieval Parameters
SIMILARITY_THRESHOLD=0.35
TOP_K_CHUNKS=5
USE_HYBRID=false
USE_RERANKER=false
IMAGE_HASH_MAX_DISTANCE=14
SIFT_MIN_INLIERS=10
IMAGE_MATCH_MIN_CONFIDENCE=0.40
