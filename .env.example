# =============================================================================
# Enterprise RAG Assistant Configuration Template
# Generate a ready .env file by running: python scripts/setup.py
# =============================================================================

# Server & Network Configuration
HOST=0.0.0.0
PORT=8000
COOKIE_SECURE=false
DEMO_MODE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001,http://localhost:8000,http://localhost:8001

# Company Branding
COMPANY_NAME=ABC Technologies

# Groq LLM API Configuration (Only supported third-party LLM provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FAST_MODEL=openai/gpt-oss-20b
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_TEMPERATURE=0.2

# Security & Authentication
# Replace with a cryptographically secure random string (python scripts/setup.py does this automatically)
JWT_SECRET=your_jwt_secret_here_generate_with_setup_script
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Seed Credentials (Created on first startup if user does not exist)
ADMIN_EMAIL=admin@abctechnologies.com
ADMIN_PASSWORD=Admin@123

# Database & Storage
# SQLite (default): sqlite:///./rag_company.db
# PostgreSQL: postgresql://rag_user:rag_password@localhost:5432/rag_company
STORAGE_DIR=.
DATABASE_URL=sqlite:///./rag_company.db
CHROMA_DIR=chroma_data
UPLOAD_DIR=uploads
LOG_DIR=logs

# Embedding & Retrieval Settings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
SIMILARITY_THRESHOLD=0.35
TOP_K_CHUNKS=5
USE_HYBRID=false
USE_RERANKER=false

# Computer Vision & Image Matching Thresholds
IMAGE_HASH_MAX_DISTANCE=12
SIFT_MIN_INLIERS=15
IMAGE_MATCH_MIN_CONFIDENCE=0.40
